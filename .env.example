VITE_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_ID/pub?output=csv

# Google Analytics 4 — usate solo lato server dalla function api/ga4.js,
# mai esposte al client. Da un service account GCP con ruolo "Viewer"
# aggiunto alla property GA4 (Amministrazione GA4 > Accesso alla property).
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=nome-service-account@progetto.iam.gserviceaccount.com
# Incolla la private_key dal JSON del service account, con \n letterali per gli a-capo
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Login dashboard — password unica condivisa, verificata da api/login.js.
DASHBOARD_PASSWORD=scegli-una-password-robusta
# Segreto usato per firmare il cookie di sessione (api/_auth.js). Genera una
# stringa casuale lunga, es. con: openssl rand -base64 32
SESSION_SECRET=stringa-casuale-lunga-e-segreta
